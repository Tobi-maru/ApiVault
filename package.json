{
    "name": "api-vault",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "workspaces": [
        "web"
    ],
    "scripts": {
        "dev": "concurrently \"bun run dev:server\" \"bun run dev:web\"",
        "dev:server": "tsx watch server/index.ts",
        "dev:web": "bun run --cwd web dev",
        "clean": "rm -rf dist public",
        "build": "bun run clean && bun run build:server && bun run build:web",
        "build:server": "bunx prisma generate && bunx tsc -p tsconfig.json",
        "build:web": "bun run --cwd web build",
        "start": "node dist/index.js",
        "migrate:deploy": "bunx prisma migrate deploy",
        "prisma:studio": "bunx prisma studio"
    },
    "dependencies": {
        "@clerk/express": "^2.0.7",
        "@prisma/client": "^5.0.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^20.12.7",
        "concurrently": "^8.2.2",
        "prisma": "^5.0.0",
        "tsx": "^4.7.2",
        "typescript": "^5.4.5"
    }
}
