generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiKey {
  id           String   @id @default(cuid())
  userId       String
  service      String
  projectName  String
  environment  String?
  key          String
  currentUsage Float    @default(0)
  usageLimit   Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
